<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><meta name="theme-color" content="#f7f8f6"><title>SEED v0.1.0 — Personal AI Secretary</title>
<style>
:root{--ink:#1f302b;--muted:#7d8880;--green:#376b52;--mint:#e6eee8;--line:#e4e9e3;--bg:#f7f8f6;--white:#fff;--danger:#a84444;font-family:-apple-system,BlinkMacSystemFont,"Hiragino Kaku Gothic ProN","Yu Gothic",Meiryo,sans-serif;color:var(--ink)}*{box-sizing:border-box}body{margin:0;background:var(--bg);min-height:100dvh}button,input,textarea,select{font:inherit}button{cursor:pointer}button:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid #a8cbb8;outline-offset:2px}.layout{display:grid;grid-template-columns:240px minmax(0,1fr);min-height:100dvh}.sidebar{background:#fff;border-right:1px solid var(--line);padding:30px 18px;display:flex;flex-direction:column;gap:22px}.brand{font-family:Georgia,serif;font-weight:700;font-size:39px;letter-spacing:-2px;padding:0 13px}.brand i{color:#649b77;font-style:normal}.brand-sub{padding:0 14px;margin-top:-19px;font-size:10px;letter-spacing:2px;color:var(--muted)}.nav{display:grid;gap:6px}.nav button{border:0;background:transparent;text-align:left;padding:13px 14px;border-radius:13px;color:#66746c;display:flex;gap:12px;align-items:center;font-size:14px}.nav button.active{background:#eaf2ec;color:#245c3d;font-weight:700}.nav svg,.mobile-nav svg{width:19px;height:19px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linejoin:round;stroke-linecap:round}.side-bottom{margin-top:auto;font-size:12px;color:var(--muted);line-height:1.8;padding:0 12px}.main{width:100%;max-width:1100px;margin:auto;padding:34px 45px 90px}.topline{display:flex;justify-content:space-between;align-items:center;color:var(--muted);font-size:12px;letter-spacing:.7px}.status{display:flex;gap:7px;align-items:center;background:white;border:1px solid var(--line);border-radius:25px;padding:8px 11px;font-size:11px}.dot{height:7px;width:7px;border-radius:50%;background:#b9a15b}.page{display:none}.page.active{display:block}.intro{margin:44px 0 27px}.eyebrow{font-size:12px;color:var(--green);font-weight:700;letter-spacing:2px}.intro h1{font-size:clamp(29px,4.6vw,43px);letter-spacing:-1.7px;line-height:1.45;margin:10px 0 9px;font-weight:650}.intro p{margin:0;color:var(--muted);font-size:14px;line-height:1.8}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.card,.panel{background:var(--white);border:1px solid var(--line);border-radius:20px;padding:22px}.card .label{font-size:12px;color:var(--muted)}.card .num{font-size:34px;letter-spacing:-1px;font-weight:650;margin:9px 0}.card .detail{font-size:12px;color:var(--green)}.section{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:30px 0 14px}.section h2{font-size:17px;margin:0;letter-spacing:-.4px}.section button,.link{color:var(--green);border:0;background:none;font-size:13px;font-weight:650}.task-list{display:grid;gap:9px}.task{display:flex;gap:12px;align-items:center;background:#fff;padding:16px;border:1px solid var(--line);border-radius:15px;min-width:0}.task input{appearance:none;border:1.5px solid #a8baad;border-radius:7px;width:21px;height:21px;flex:none;margin:0;position:relative}.task input:checked{background:var(--green);border-color:var(--green)}.task input:checked:after{content:'✓';position:absolute;color:white;left:4px;top:-2px}.task-body{flex:1;min-width:0}.task-name{display:block;word-wrap:break-word;font-size:14px;font-weight:600}.completed .task-name{text-decoration:line-through;color:#9aa69d}.task-meta{font-size:11px;color:var(--muted);margin-top:5px}.icon-btn{border:0;background:transparent;color:#92a098;padding:9px;border-radius:10px}.icon-btn:hover{background:#f4f5f3}.empty{border:1px dashed #cdd9ce;border-radius:16px;padding:31px 20px;color:var(--muted);text-align:center;font-size:13px}.btn{border:0;background:var(--green);color:white;padding:12px 19px;border-radius:11px;font-size:13px;font-weight:650}.btn.secondary{background:var(--mint);color:var(--green)}.btn.light{background:#fff;border:1px solid var(--line);color:var(--ink)}.btn:disabled{opacity:.5;cursor:not-allowed}.composer{display:grid;grid-template-columns:1fr auto;gap:9px}.composer input,.field,.composer textarea{background:#fff;border:1px solid #dbe4db;border-radius:11px;padding:12px 13px;color:var(--ink);min-width:0;font-size:14px}.field{width:100%}.task-entry{display:grid;grid-template-columns:1fr 156px auto;gap:10px}.footnote{font-size:12px;color:var(--muted);line-height:1.75}.assistant-preview{display:flex;gap:16px;align-items:start;background:#eaf2eb;border:1px solid #d5e5d7;border-radius:17px;padding:21px}.assistant-mark{background:#d4e7d7;border-radius:14px;font-family:Georgia,serif;font-size:28px;color:var(--green);width:48px;height:48px;display:grid;place-items:center;flex:none}.assistant-preview b{font-size:15px}.assistant-preview p{font-size:13px;color:#66786b;line-height:1.9;margin:7px 0 0}.chat-shell{border:1px solid var(--line);background:#fff;border-radius:20px;overflow:hidden;display:flex;flex-direction:column;min-height:min(560px,65dvh)}.chat-head{padding:18px 20px;border-bottom:1px solid var(--line);display:flex;gap:12px;align-items:center}.chat-head strong{font-size:15px}.chat-head small{font-size:11px;color:var(--muted);display:block;margin-top:5px}.chat-messages{padding:22px;flex:1;display:flex;flex-direction:column;gap:12px;overflow:auto;max-height:390px}.bubble{max-width:86%;padding:13px 15px;border-radius:16px;line-height:1.7;font-size:13px;white-space:pre-wrap;overflow-wrap:anywhere}.bubble.user{align-self:flex-end;background:#e7f0e8}.bubble.system{align-self:flex-start;background:#f3f5f2;color:#5e6e62}.chat-entry{padding:13px;border-top:1px solid var(--line)}.chat-entry textarea{resize:vertical;min-height:48px;max-height:110px}.chat-entry .composer{align-items:end}.row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.muted{color:var(--muted)}.settings-block{max-width:660px}.settings-block h3{font-size:15px;margin-top:0}.settings-block p{font-size:13px;line-height:1.8;color:var(--muted)}.settings-actions{display:flex;flex-wrap:wrap;gap:9px}.notice{display:none;position:fixed;z-index:20;bottom:25px;left:50%;transform:translateX(-50%);background:#253e30;color:white;padding:12px 17px;border-radius:14px;box-shadow:0 10px 30px #24372925;font-size:12px;max-width:90vw;text-align:center}.notice.show{display:block}.mobile-nav{display:none}.date-input{color:var(--ink)}@media(max-width:760px){.layout{display:block}.sidebar{display:none}.main{padding:21px 18px 112px;max-width:580px}.intro{margin:39px 0 23px}.intro h1{font-size:30px}.cards{gap:8px}.card{padding:16px 12px;border-radius:16px}.card .num{font-size:27px}.card .label,.card .detail{font-size:10px}.panel{padding:17px}.task-entry{grid-template-columns:1fr 132px;gap:8px}.task-entry .btn{grid-column:1/-1}.mobile-nav{display:grid;grid-template-columns:repeat(4,1fr);position:fixed;left:0;right:0;bottom:0;z-index:10;background:#fff;border-top:1px solid var(--line);padding:9px 6px calc(9px + env(safe-area-inset-bottom));box-shadow:0 -8px 25px #25352907}.mobile-nav button{display:flex;align-items:center;justify-content:center;gap:4px;flex-direction:column;border:0;background:transparent;color:#8b988f;padding:6px 0;font-size:10px}.mobile-nav button.active{color:var(--green);font-weight:700}.notice{bottom:92px}.chat-shell{min-height:58dvh}.chat-messages{max-height:43dvh}}@media(prefers-reduced-motion:no-preference){.page.active{animation:fade .18s ease}@keyframes fade{from{opacity:.5;transform:translateY(5px)}to{opacity:1;transform:none}}}
</style>
</head>
<body>
<div class="layout"><aside class="sidebar"><div class="brand">seed<i>.</i></div><div class="brand-sub">PERSONAL AI SECRETARY</div><nav class="nav" id="desktop-nav"></nav><div class="side-bottom">v0.1.0 · LOCAL PROTOTYPE<br>このバージョンはAI未接続です。</div></aside><main class="main"><div class="topline"><span id="today-label"></span><div class="status"><span class="dot"></span> AI未接続・無料試作版</div></div>
<section id="home" class="page active"><div class="intro"><div class="eyebrow">GOOD DAY</div><h1>今日のことを、<br>ひとつずつ。</h1><p>あなたの予定とタスクを整理する、SEEDの最初の一歩。</p></div><div class="cards"><div class="card"><div class="label">すべてのタスク</div><div class="num" id="stat-total">0</div><div class="detail">登録済み</div></div><div class="card"><div class="label">未完了</div><div class="num" id="stat-open">0</div><div class="detail">これからの仕事</div></div><div class="card"><div class="label">完了</div><div class="num" id="stat-done">0</div><div class="detail">終わった仕事</div></div></div><div class="section"><h2>次にやること</h2><button type="button" data-go="tasks">すべて見る →</button></div><div id="home-tasks" class="task-list"></div><div class="section"><h2>SEEDについて</h2></div><div class="assistant-preview"><div class="assistant-mark">s.</div><div><b>AI秘書は、これから育てていきます。</b><p>今はタスク管理・ローカル保存・チャット画面の試作段階。AIへの接続や自動処理は今後のアップデートで実装します。</p></div></div></section>
<section id="tasks" class="page"><div class="intro"><div class="eyebrow">TASK MANAGER</div><h1>タスク管理</h1><p>やることを登録して、進捗を整理します。</p></div><div class="panel"><form id="task-form" class="task-entry"><input id="task-title" class="field" maxlength="120" required placeholder="やることを入力"><input id="task-date" class="field date-input" type="date" aria-label="期限"><button class="btn" type="submit">＋ タスクを追加</button></form></div><div class="section"><h2>タスク一覧</h2><span class="muted" style="font-size:12px" id="tasks-count"></span></div><div id="all-tasks" class="task-list"></div><p class="footnote">タスクはこのブラウザの端末内に保存されます。別の端末には自動同期されません。</p></section>
<section id="chat" class="page"><div class="intro"><div class="eyebrow">AI ASSISTANT</div><h1>SEEDに相談</h1><p>チャット画面の先行試作です。</p></div><div class="chat-shell"><div class="chat-head"><div class="assistant-mark" style="width:42px;height:42px;font-size:24px">s.</div><div><strong>SEED</strong><small>AIはまだ接続されていません</small></div></div><div id="chat-messages" class="chat-messages"></div><form id="chat-form" class="chat-entry"><div class="composer"><textarea id="chat-text" class="field" placeholder="メモや相談内容を入力（AI返信は未対応）" maxlength="3000"></textarea><button type="submit" class="btn">記録</button></div></form></div><p class="footnote">入力内容は端末内に記録します。AIによる返信・分析・外部送信はまだ行いません。</p></section>
<section id="settings" class="page"><div class="intro"><div class="eyebrow">PREFERENCES</div><h1>設定・データ</h1><p>保存内容を確認・管理できます。</p></div><div class="panel settings-block"><h3>データの保存先</h3><p>SEED v0.1.0は、このブラウザのローカルストレージに保存します。Safariのサイトデータを消すと失われる可能性があります。定期的にバックアップしてください。</p><div class="settings-actions"><button id="export" class="btn secondary">データをバックアップ</button><label class="btn light" for="import-file" style="cursor:pointer">バックアップを読み込む</label><input id="import-file" type="file" accept="application/json,.json" hidden><button id="clear" class="btn light" style="color:var(--danger)">データを初期化</button></div></div><div class="panel settings-block" style="margin-top:15px"><h3>現在の開発状況</h3><p>✓ タスク登録・削除・完了<br>✓ 端末内の保存・バックアップ<br>✓ スマホ向け画面<br>○ AIとの会話（未接続）<br>○ ユーザー登録・クラウド同期（未実装）<br>○ メールやカレンダーとの連携（未実装）</p></div></section>
</main></div><nav class="mobile-nav" id="mobile-nav" aria-label="メインメニュー"></nav><div class="notice" role="status" id="notice"></div>
<script>
(()=>{'use strict';const STORE='seed_v010_local';const icons={home:'<path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z"/>',tasks:'<rect x="3" y="3" width="18" height="18" rx="3"/><path d="m7 12 3 3 6-7"/>',chat:'<path d="M21 11.5a8.4 8.4 0 0 1-8.4 8.4H6l-4 2 1.5-5A8.4 8.4 0 1 1 21 11.5z"/>',settings:'<circle cx="12" cy="12" r="3"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/>'};const nav=[['home','ホーム'],['tasks','タスク'],['chat','AIチャット'],['settings','設定']];function safeLoad(){try{const v=JSON.parse(localStorage.getItem(STORE)||'{}');return {tasks:Array.isArray(v.tasks)?v.tasks.filter(x=>x&&typeof x.title==='string').slice(0,500):[],messages:Array.isArray(v.messages)?v.messages.filter(x=>x&&typeof x.text==='string').slice(-200):[]}}catch{return {tasks:[],messages:[]}}}let data=safeLoad(),page='home';const $=id=>document.getElementById(id);const date=new Date();$('today-label').textContent=new Intl.DateTimeFormat('ja-JP',{year:'numeric',month:'long',day:'numeric',weekday:'long'}).format(date);function save(){try{localStorage.setItem(STORE,JSON.stringify(data));return true}catch{toast('保存容量を確認してください');return false}}function toast(t){const el=$('notice');el.textContent=t;el.classList.add('show');clearTimeout(toast.timer);toast.timer=setTimeout(()=>el.classList.remove('show'),2300)}function svg(key){return `<svg viewBox="0 0 24 24" aria-hidden="true">${icons[key]}</svg>`}for(const id of ['desktop-nav','mobile-nav']){$(id).innerHTML=nav.map(([k,n])=>`<button type="button" data-go="${k}" class="${k===page?'active':''}">${svg(k)}<span>${n}</span></button>`).join('')}function goto(k){if(!nav.some(x=>x[0]===k))return;page=k;document.querySelectorAll('.page').forEach(e=>e.classList.toggle('active',e.id===k));document.querySelectorAll('[data-go]').forEach(e=>{e.classList.toggle('active',e.dataset.go===k);if(e.dataset.go===k)e.setAttribute('aria-current','page');else e.removeAttribute('aria-current')});window.scrollTo(0,0);render()}document.addEventListener('click',e=>{const target=e.target.closest('[data-go]');if(target)goto(target.dataset.go)});function taskNode(task){const node=document.createElement('div');node.className='task'+(task.done?' completed':'');const check=document.createElement('input');check.type='checkbox';check.checked=!!task.done;check.setAttribute('aria-label',task.title+'を完了');check.addEventListener('change',()=>{task.done=check.checked;save();render()});const info=document.createElement('div');info.className='task-body';const title=document.createElement('span');title.className='task-name';title.textContent=task.title;info.append(title);if(task.due){const meta=document.createElement('div');meta.className='task-meta';meta.textContent='期限：'+task.due;info.append(meta)}const del=document.createElement('button');del.className='icon-btn';del.textContent='削除';del.setAttribute('aria-label',task.title+'を削除');del.addEventListener('click',()=>{if(confirm('このタスクを削除しますか？')){data.tasks=data.tasks.filter(x=>x.id!==task.id);save();render()}});node.append(check,info,del);return node}function fillTasks(el,tasks,empty){el.replaceChildren();if(!tasks.length){const x=document.createElement('div');x.className='empty';x.textContent=empty;el.append(x);return}tasks.forEach(x=>el.append(taskNode(x)))}function render(){const total=data.tasks.length,open=data.tasks.filter(x=>!x.done);$('stat-total').textContent=total;$('stat-open').textContent=open.length;$('stat-done').textContent=total-open.length;$('tasks-count').textContent=total+'件';fillTasks($('home-tasks'),open.slice(0,4),'未完了のタスクはありません。タスクを追加してみよう。');fillTasks($('all-tasks'),[...data.tasks].sort((a,b)=>Number(a.done)-Number(b.done)),'まだタスクがありません。上から追加できます。');renderMessages()}$('task-form').addEventListener('submit',e=>{e.preventDefault();const title=$('task-title').value.trim(),due=$('task-date').value;if(!title)return;data.tasks.unshift({id:(crypto.randomUUID?crypto.randomUUID():String(Date.now())+Math.random()),title,due,done:false});if(save()){$('task-form').reset();render();toast('タスクを保存しました')}});function renderMessages(){const el=$('chat-messages');el.replaceChildren();const intro=document.createElement('div');intro.className='bubble system';intro.textContent='ここはSEEDのチャット画面です。現在はAI未接続のため、送った文章はメモとして記録されます。自動返信はありません。';el.append(intro);for(const m of data.messages){const node=document.createElement('div');node.className='bubble user';node.textContent=m.text;el.append(node)}el.scrollTop=el.scrollHeight}$('chat-form').addEventListener('submit',e=>{e.preventDefault();const value=$('chat-text').value.trim();if(!value)return;data.messages.push({text:value,created:new Date().toISOString()});data.messages=data.messages.slice(-200);if(save()){$('chat-text').value='';renderMessages();toast('メモを記録しました（AI返信は未接続）')}});$('export').addEventListener('click',()=>{const blob=new Blob([JSON.stringify({version:1,exportedAt:new Date().toISOString(),...data},null,2)],{type:'application/json'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='seed-backup-'+new Date().toISOString().slice(0,10)+'.json';document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),5000);toast('バックアップを作成しました')});$('import-file').addEventListener('change',async e=>{const f=e.target.files?.[0];if(!f)return;try{if(f.size>2e6)throw Error('大きすぎます');const input=JSON.parse(await f.text());if(!Array.isArray(input.tasks)||!Array.isArray(input.messages))throw Error('形式が違います');if(!confirm('現在の保存データをバックアップの内容で置き換えますか？'))return;data={tasks:input.tasks.filter(x=>x&&typeof x.title==='string').slice(0,500).map(x=>({id:String(x.id||Math.random()),title:x.title.slice(0,120),due:typeof x.due==='string'?x.due.slice(0,10):'',done:!!x.done})),messages:input.messages.filter(x=>x&&typeof x.text==='string').slice(-200).map(x=>({text:x.text.slice(0,3000),created:String(x.created||'')}))};save();render();toast('バックアップを読み込みました')}catch{toast('バックアップを読み込めませんでした')}finally{e.target.value=''}});$('clear').addEventListener('click',()=>{if(confirm('すべてのタスクとチャットメモを削除しますか？ この操作は元に戻せません。')){data={tasks:[],messages:[]};save();render();toast('データを初期化しました')}});render()})();
</script>
</body></html>
